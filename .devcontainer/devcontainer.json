{
  "name": "rds_ws",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "bot",
      "PASSWORD": ""
    }
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--privileged",
    "--network=host",
    "--env=NVIDIA_VISIBLE_DEVICES=all",
    "--env=NVIDIA_DRIVER_CAPABILITIES=all",
    "--env=DISPLAY",
    "--gpus",
    "all",
    "--env=QT_X11_NO_MITSHM=1",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--volume=/etc/X11:/etc/X11:rw",
    "--volume=/dev:/dev:rw",
    "--device-cgroup-rule=c 189:* rmw",
    "--volume=/dev/bus/usb:/dev/bus/usb:rw",
    "--volume=/dev/input:/dev/input:rw", // required for open3d visualization
    "--volume=${localEnv:HOME}/.ssh:/home/bot/.ssh:ro"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "CONTAINER_NAME": "r-d-s-a",
    "TZ": "America/New_York"
  },
  // Add the IDs of extensions you want installed when the container is created.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.vscode-pylance",
        "ms-python.python",
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "mutantdino.resourcemonitor",
        "mhutchie.git-graph",
        "coenraads.bracket-pair-colorizer",
        "llvm-vs-code-extensions.vscode-clangd",
        "vscodevim.vim"
      ]
    }
  },
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "/bin/bash /home/bot/rds_ws/src/robot-description-setup-assistant/.devcontainer/post_create.bash",
  // // Use 'postAttachCommand' to run commands each time you attach to the container.
  "postAttachCommand": "/bin/bash /home/bot/rds_ws/src/robot-description-setup-assistant/.devcontainer/post_attach.bash",
  // Mount aio_palletizing_app under src/
  "workspaceMount": "source=${localWorkspaceFolder}/../../,target=/home/bot/rds_ws/,type=bind,consistency=cached",
  "workspaceFolder": "/home/bot",
  // Connect as a non-root user. See https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "bot",
  // See https://code.visualstudio.com/docs/remote/containers-advanced#_specifying-the-default-container-user
  "containerUser": "bot"
}
