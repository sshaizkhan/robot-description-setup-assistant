<?xml version="1.0"?>
<robot name="mobile_base">
  <material name="body"><color rgba="0.2 0.35 0.5 1"/></material>
  <material name="wheel"><color rgba="0.1 0.1 0.1 1"/></material>
  <link name="base_link">
    <visual><origin xyz="0 0 0.20" rpy="0 0 0"/><geometry><box size="0.6 0.5 0.24"/></geometry><material name="body"/></visual>
    <visual><origin xyz="0.22 0.27 0.08" rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.05"/></geometry><material name="wheel"/></visual>
    <visual><origin xyz="-0.22 0.27 0.08" rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.05"/></geometry><material name="wheel"/></visual>
    <visual><origin xyz="0.22 -0.27 0.08" rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.05"/></geometry><material name="wheel"/></visual>
    <visual><origin xyz="-0.22 -0.27 0.08" rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.05"/></geometry><material name="wheel"/></visual>
  </link>
  <link name="mount_point"/>
  <joint name="to_mount" type="fixed"><parent link="base_link"/><child link="mount_point"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/></joint>
</robot>
