<robot name="table_mount">
  <material name="wood"><color rgba="0.62 0.5 0.36 1"/></material>
  <material name="leg"><color rgba="0.3 0.3 0.32 1"/></material>
  <link name="base_link">
    <visual><origin xyz="0 0 0.74" rpy="0 0 0"/>
      <geometry><box size="0.6 0.6 0.04"/></geometry><material name="wood"/></visual>
    <visual><origin xyz="0.26 0.26 0.36" rpy="0 0 0"/><geometry><box size="0.04 0.04 0.72"/></geometry><material name="leg"/></visual>
    <visual><origin xyz="-0.26 0.26 0.36" rpy="0 0 0"/><geometry><box size="0.04 0.04 0.72"/></geometry><material name="leg"/></visual>
