<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_description_setup_assistant</name>
  <version>0.1.0</version>
  <description>Robot catalog data, images, and web-UI launch for the Robot Description Setup Assistant.</description>
  <maintainer email="sshaizkhan@gmail.com">Shahwaz Khan</maintainer>
  <license>BSD</license>

  <author email="sshaizkhan@gmail.com">Shahwaz Khan</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The web-UI launch starts the C++ catalog node. -->
  <exec_depend>robot_catalog_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
